# ============ 环境变量 / 密钥 ============
# 第 23 天才会用到 .env，今天只要确保它被忽略，绝不进仓库
.env
.env.local
.env.*.local

# ============ 依赖包 ============
node_modules/
vendor/

# ============ 虚拟环境（Python 等）============
venv/
.venv/
env/
.venv/
.conda/
*.egg-info/

# ============ 编译缓存 ============
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.tox/

# ============ 构建产物 ============
dist/
build/
out/
.next/
.nuxt/
.output/

